{
  "opcode": "string.upper",
  "description": "Convert a string to upper case.",
  "inputs": {
    "value": {
      "type": "string",
      "description": "The text to convert."
    }
  },
  "outputs": {
    "result": {
      "type": "string",
      "description": "The input text in upper case."
    }
  },
  "side_effect": false,
  "visibility": "composable",
  "examples": [
    {
      "inputs": {
        "value": "hello"
      },
      "outputs": {
        "result": "HELLO"
      },
      "description": "Lower-case text is converted."
    }
  ]
}
